---
layout: base.njk
title: Lu Immich | Sobre
permalink: "/sobre/"
custom_css: "about.css"
---

<main class="about-cv">
  
  <div class="cv-grid grid-container">
    
    <!-- COLUNA ESQUERDA: FIXA E MINIMALISTA -->
    <aside class="cv-sidebar">
      <div class="cv-photo-container">
      {% image "/project-files/lu-immich.jpg", "Lu Immich", "cv-photo" %}
      </div> 
        
      <div class="cv-contact">
        <a href="mailto:lu.immich@gmail.com">lu.immich@gmail.com</a>
        <a href="https://lattes.cnpq.br/6938481194529175" target="_blank" rel="noopener">Lattes</a>
        <a href="https://philpeople.org/profiles/lu-immich" target="_blank" rel="noopener">PhilPeople</a>
        <a href="https://github.com/anothermimich" target="_blank" rel="noopener">GitHub</a>
      </div>
    </aside>

    <!-- COLUNA DIREITA: CONTEÚDO -->
    <article class="cv-content">
      
      <section class="cv-section intro-section">
        <p class="cv-intro-text">{{ about.intro | safe }}</p>
      </section>

      <!-- FOCO E HABILIDADES -->
      <section class="cv-section cv-skills-section">
        <div class="cv-skills-col">
          <h2 class="cv-section-title">Pesquisa</h2>
          <ul class="cv-list">
            {% for skill in about.skills.philosophy %}
              <li>{{ skill }}</li>
            {% endfor %}
          </ul>
        </div>
        <div class="cv-skills-col">
          <h2 class="cv-section-title">Design</h2>
          <ul class="cv-list">
            {% for skill in about.skills.design %}
              <li>{{ skill }}</li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- GRÁFICOS DE BARRA (IDIOMAS E CAFÉ) -->
      <section class="cv-section cv-charts-section">
        <div class="cv-chart-col">
          <h2 class="cv-section-title">Idiomas</h2>
          <div class="cv-chart-list">
            {% for item in about.charts.languages %}
            <div class="cv-chart-item">
              <span class="cv-chart-label">{{ item.name }}</span>
              <div class="cv-chart-track">
                <div class="cv-chart-fill" style="width: {{ item.level }}%;"></div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>

        <div class="cv-chart-col">
          <h2 class="cv-section-title">Café</h2>
          <div class="cv-chart-list">
            {% for item in about.charts.coffee %}
            <div class="cv-chart-item">
              <span class="cv-chart-label">{{ item.name }}</span>
              <div class="cv-chart-track">
                <div class="cv-chart-fill" style="width: {{ item.level }}%;"></div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
      </section>

    </article>
  </div>
</main>