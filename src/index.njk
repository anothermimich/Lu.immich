---
layout: base.njk
title: Lu Immich
permalink: "/"
---

<main class="hero">
  <ul id="hero-list">
    <!-- O JavaScript injeta os projetos aqui de forma síncrona -->
  </ul>
</main>

<!-- Pré-renderiza todas as imagens otimizadas no build -->
<template id="optimized-images">
  {% for proj in home %}
    <div data-project-url="{{ proj.url }}">
      <!-- Chama o shortcode passando a classe hero-img -->
      {% image proj.img, proj.title, "hero-img", "(max-width: 768px) 100vw, 800px" %}
    </div>
  {% endfor %}
</template>

<script>
  const allProjects = {{ home | dump | safe }};

  function getWeightedRandom(projects, count) {
      let result = [];
      let pool = [...projects];

      for (let i = 0; i < count; i++) {
          if (pool.length === 0) break;

          let totalWeight = pool.reduce((sum, p) => sum + p.weight, 0);
          let random = Math.random() * totalWeight;

          for (let j = 0; j < pool.length; j++) {
              random -= pool[j].weight;
              
              if (random <= 0) {
                  result.push(pool[j]);
                  pool.splice(j, 1); 
                  break;
              }
          }
      }
      return result;
  }

  const maxToDraw = Math.min(10, allProjects.length);
  const selectedProjects = getWeightedRandom(allProjects, maxToDraw);
  
  const ul = document.getElementById('hero-list');
  // Captura o contêiner com as imagens processadas pelo Eleventy
  const templateImages = document.getElementById('optimized-images').content;
  let html = '';

  selectedProjects.forEach((proj, index) => {
      const num = String(index + 1).padStart(2, '0');
      
      const pictureTag = templateImages.querySelector(`[data-project-url="${proj.url}"]`).innerHTML;

      html += `
        <li>
          <a href="${proj.url}">
            <p>(${num})</p>
            <div>
              <p>${proj.title}</p>
              <p>${proj.type}</p>
              <p>${proj.year}</p>
            </div>
          </a>
        </li>
        <!-- Envolve a tag picture gerada no wrapper -->
        <div class="hero-picture-wrapper">
          ${pictureTag}
        </div>
      `;
  });

  ul.innerHTML = html;
</script>

<script src="/js/home.js"></script>